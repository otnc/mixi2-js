{
  "name": "mixi2-js",
  "version": "1.5.3",
  "description": "TypeScript/JavaScript SDK for mixi2 Application API",
  "scripts": {
    "build": "tsdown --config-loader native",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p examples/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "check": "prettier --write . && eslint --fix .",
    "ci": "prettier --check . && eslint .",
    "check:package": "publint && attw --pack . --profile node16",
    "checkversion": "ncu",
    "up": "ncu -u && npm install",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "api",
    "bot",
    "grpc",
    "mixi",
    "mixi.social",
    "mixi2",
    "sdk",
    "webhook"
  ],
  "homepage": "https://mixi2.js.org/",
  "bugs": {
    "url": "https://github.com/otnc/mixi2-js/issues"
  },
  "license": "Apache-2.0",
  "author": "otoneko.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/mixi2-js.git"
  },
  "files": [
    "dist",
    "proto",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./helpers": {
      "import": {
        "types": "./dist/helpers/index.d.mts",
        "default": "./dist/helpers/index.mjs"
      },
      "require": {
        "types": "./dist/helpers/index.d.cts",
        "default": "./dist/helpers/index.cjs"
      }
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "consola": "^3.4.2",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "0.23.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no -- lint-staged",
    "commit-msg": "npx --no -- commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml}": "prettier --write"
  },
  "allowScripts": {
    "protobufjs": false,
    "simple-git-hooks": false
  }
}
